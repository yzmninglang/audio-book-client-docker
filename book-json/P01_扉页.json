      0.0,
      0.0,
      0.0,
      0.0
    ],
    "delay": 400
  },
  {
    "speaker": "旁白",
    "content": "根据一九四九年得到的相当收益，这个忠告是好的和有益的。",
    "emo_vector": [
      0.0,
      0.0,
      0.0,
