      0.0,
      0.0,
      0.0,
      0.0
    ],
    "delay": 400
  },
  {
    "speaker": "旁白",
    "content": "许多其他类似的陈词滥调，现在要么是不正确的，要么因例外太多而毫无用处。",
    "emo_vector": [
      0.0,
